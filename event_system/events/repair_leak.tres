[gd_resource type="Resource" script_class="DangerousTaskEvent" format=3]

[ext_resource type="Script" path="res://event_system/events/dangerous_task_event.gd" id="1_danger"]

[resource]
script = ExtResource("1_danger")
event_id = "repair_leak"
title = "[TBD] Burst Coolant Pipe"
description = "[TBD] A coolant pipe in the storage bay has burst. If nobody fixes it, the remaining food will spoil faster. Someone needs to go deal with it."
repeatable = true
success_text = "[TBD] {name} fixed the pipe."
abandon_text = "[TBD] Nobody fixed it. Some of the food has spoiled."
abandon_food_change = -2
