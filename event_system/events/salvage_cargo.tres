[gd_resource type="Resource" script_class="DangerousTaskEvent" format=3]

[ext_resource type="Script" path="res://event_system/events/dangerous_task_event.gd" id="1_danger"]

[resource]
script = ExtResource("1_danger")
event_id = "salvage_cargo"
title = "[TBD] Supply Crate Outside"
description = "[TBD] An unburned supply crate is snagged on the outside of the cargo hold. Someone needs to suit up, go out, and haul it back in."
repeatable = true
success_text = "[TBD] {name} hauled the crate back in. There are 2 Food inside."
abandon_text = "[TBD] The crate slowly drifts away."
success_food_change = 2
